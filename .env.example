NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=
NEXT_PUBLIC_NEXT_OMEN_MARKET_ADDRESS=
NEXT_PUBLIC_BATTLE_COORDINATOR_ADDRESS=

# Optional indexed read source. Local fixture mode is used when unset.

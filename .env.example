EXPECTED_DEPLOYER=
CREATURE_REGISTRY_ADDRESS=
ROOM_REGISTRY_ADDRESS=
OMEN_PUBLISHER_ADDRESS=
DEMO_TOKEN_ADDRESS=
NEXT_OMEN_MARKET_ADDRESS=
